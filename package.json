{
  "name": "chiban",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source land-use software for small US towns.",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "scripts": {
    "lint": "biome check . && eslint . --no-warn-ignored",
    "lint:fix": "biome check --write . && eslint . --fix --no-warn-ignored",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:unit": "vitest run --project unit",
    "test:unit:west": "TZ=America/Los_Angeles vitest run --project unit",
    "test:integration": "vitest run --project integration --passWithNoTests",
    "gate": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:unit:west && pnpm test:integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file .env src/entrypoints/migrate.ts",
    "staff:create": "tsx --env-file .env scripts/createStaffUser.ts",
    "worker": "tsx --env-file .env src/entrypoints/worker.ts",
    "db:seed:demo": "tsx --env-file .env scripts/seedDemo.ts"
  },
  "dependencies": {
    "@fontsource-variable/mulish": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@hookform/resolvers": "^7.0.1",
    "@tanstack/react-query": "^5.105.1",
    "@trpc/client": "^11.22.1",
    "@trpc/react-query": "^11.22.1",
    "@trpc/server": "^11.22.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.66.0",
    "next": "^16",
    "nodemailer": "^10.3.1",
    "otpauth": "^9.5.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.91.0",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testcontainers/postgresql": "^12.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4"
  }
}
