{
  "name": "chiban-docs",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start --port 3300",
    "build": "docusaurus build",
    "serve": "docusaurus serve --port 3300",
    "clear": "docusaurus clear",
    "typecheck": "tsc",
    "deploy": "pnpm build && wrangler deploy",
    "shots": "tsx scripts/captureShots.ts",
    "test": "node --import tsx --test scripts/captureShots.test.ts"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@fontsource-variable/mulish": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.1",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.64.1",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "wrangler": "4.158.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=24"
  }
