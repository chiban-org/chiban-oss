{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiban-docs",
  "compatibility_date": "2026-11-01",
  "routes": [{ "pattern": "docs.chiban.us", "custom_domain": true }],
  "assets": {
    "directory": "./build",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
