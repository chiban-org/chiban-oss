{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "incremental": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowJs": true,
    "types": ["node", "geojson"],
    "allowUmdGlobalAccess": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"], "@packs/*": ["./packs/*"] }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "packs/**/*.ts",
    "scripts/**/*.ts",
    "tests/**/*.ts",
    "deploy/**/*.ts",
    "Dockerfile.test.ts",
    "dockerCompose.dev.test.ts",
    "next.config.ts",
    "next.config.test.ts",
    "vitest.classify.ts",
    "vitest.classify.test.ts",
    "vitest.setup.ts",
    "vitest.globalSetup.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".claude", ".worktrees"]
}
